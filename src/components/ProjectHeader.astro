---
// Cabeçalho das páginas de detalhe: ícone, nome, resumo, tags e link externo.
import { Code, Globe, Terminal } from "../lib/icons";
import RepoLink from "./RepoLink.astro";
import { PROJECTS } from "../data/projects";

const ICONS = { code: Code, terminal: Terminal, globe: Globe } as const;

const { slug } = Astro.props as { slug: string };
const project = PROJECTS.find((p) => p.slug === slug);

if (!project) throw new Error(`Projeto desconhecido: ${slug}`);
const Icon = ICONS[project.icon];
---

<header class="project-header">
  <div class="project-icon" aria-hidden="true">
    <Icon width={36} height={36} />
  </div>
  <div>
    <h1>{project.name}</h1>
    <p>{project.summary}</p>
    <ul class="project-tags" aria-label="Tecnologias">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <RepoLink href={project.repo} label={`Abrir ${project.name} no GitHub`} />
  </div>
</header>

<style>
  .project-header {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--ot-line-soft);
  }
  .project-header h1 {
    margin: 0 0 0.35rem;
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }
  .project-header p {
    margin: 0 0 0.6rem;
    color: var(--ot-ink-soft);
    line-height: 1.6;
  }
  .project-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 0.75rem;
    background: var(--ot-accent-soft);
    color: var(--ot-accent);
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }
  .project-tags li {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--ot-bg-soft);
    color: var(--ot-ink-soft);
  }
</style>
