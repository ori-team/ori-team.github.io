---
// Grade de projetos com alternador lista/thumbnail.
// Estado persistido em localStorage; re-inicializado a cada View Transition.
import { GridFour, List } from "../lib/icons";
import ProjectCard from "./ProjectCard.astro";
import { PROJECTS } from "../data/projects";
---

<section class="projects-section" aria-label="Projetos">
  <div class="projects-toolbar">
    <h2>Projetos</h2>
    <div class="view-toggle" role="group" aria-label="Modo de visualização">
      <button type="button" data-set-view="grid" aria-pressed="true" title="Miniaturas">
        <GridFour width={18} height={18} aria-hidden="true" />
        <span class="sr-only">Miniaturas</span>
      </button>
      <button type="button" data-set-view="list" aria-pressed="false" title="Lista">
        <List width={18} height={18} aria-hidden="true" />
        <span class="sr-only">Lista</span>
      </button>
    </div>
  </div>
  <div class="projects" data-view="grid">
    {PROJECTS.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<script>
  // @ts-nocheck — scripts de componente viajam para o bundler como JS puro:
  // sintaxe TS aqui quebra o parse e o código chega cru (e morto) no HTML.
  import { animate, stagger } from "animejs";

  const STORAGE_KEY = "oriteam-projects-view";
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function applyView(root, view) {
    root.dataset.view = view;
    const section = root.closest(".projects-section");
    if (section) {
      section.querySelectorAll("[data-set-view]").forEach((btn) => {
        btn.setAttribute("aria-pressed", String(btn.getAttribute("data-set-view") === view));
      });
    }
    try {
      localStorage.setItem(STORAGE_KEY, view);
    } catch {
      /* modo privado: segue sem persistir */
    }
  }

  function entrance(root) {
    if (reduceMotion) return;
    animate(root.querySelectorAll(".project-card"), {
      opacity: [0, 1],
      translateY: [12, 0],
      duration: 600,
      delay: stagger(80),
      ease: "outExpo",
    });
  }

  function init() {
    document.querySelectorAll(".projects").forEach((root) => {
      // Mesma guarda do FAB: eval + `astro:page-load` no load inicial.
      if (root.dataset.gridReady) return;
      root.dataset.gridReady = "1";
      let saved = null;
      try {
        saved = localStorage.getItem(STORAGE_KEY);
      } catch {
        /* modo privado: usa o padrão */
      }
      applyView(root, saved === "list" ? "list" : "grid");
      const section = root.closest(".projects-section");
      if (section) {
        section.querySelectorAll("[data-set-view]").forEach((btn) => {
          btn.addEventListener("click", () => applyView(root, btn.getAttribute("data-set-view") || "grid"));
        });
      }
      entrance(root);
    });
  }

  document.addEventListener("astro:page-load", init);
  init();
</script>

<style>
  .projects-section {
    margin-block: 2.5rem 1rem;
  }
  .projects-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .projects-toolbar h2 {
    margin: 0;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }
  .view-toggle {
    display: flex;
    border: 1px solid var(--ot-line);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .view-toggle button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    padding: 0.5rem 0.65rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--ot-ink-soft);
  }
  .view-toggle button svg {
    display: block;
  }
  .view-toggle button[aria-pressed="true"] {
    background: var(--ot-ink);
    color: var(--ot-on-ink);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .projects {
    display: grid;
    gap: 1rem;
  }
  .projects[data-view="grid"] {
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  }
  .projects[data-view="grid"] .project-card {
    flex-direction: column;
  }
  .projects[data-view="list"] {
    grid-template-columns: 1fr;
  }
</style>
