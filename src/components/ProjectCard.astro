---
// Um card de projeto. O layout (grade ou linha) vem do container via CSS:
// `.projects[data-view="grid"]` vs `.projects[data-view="list"]`.
import { Code, Terminal } from "../lib/icons";
import { siteUrl } from "../lib/url";
import RepoLink from "./RepoLink.astro";
import type { ProjectMeta } from "../data/projects";

const ICONS = { code: Code, terminal: Terminal } as const;

interface Props {
  project: ProjectMeta;
}

const { project } = Astro.props;
const Icon = ICONS[project.icon];
---

<article class="project-card">
  <div class="project-icon" aria-hidden="true">
    <Icon width={28} height={28} />
  </div>
  <div class="project-body">
    <h3 class="project-name">
      <a href={siteUrl(`/projetos/${project.slug}/`)}>{project.name}</a>
    </h3>
    <p class="project-summary">{project.summary}</p>
    <ul class="project-tags" aria-label="Tecnologias">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <RepoLink href={project.repo} />
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--ot-line-soft);
    border-radius: 0.75rem;
    background: var(--ot-surface);
  }
  .project-card:hover {
    border-color: var(--ot-line-strong);
  }
  .project-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.625rem;
    background: var(--ot-accent-soft);
    color: var(--ot-accent);
  }
  .projects[data-view="list"] .project-card {
    align-items: center;
  }
  .project-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .project-name {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .project-name a {
    color: inherit;
    text-decoration: none;
  }
  /* Card inteiro clicável para o detalhe; RepoLink fica por cima. */
  .project-name a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .project-name a:hover,
  .project-card:hover .project-name a {
    color: var(--ot-accent);
  }
  .project-summary {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ot-ink-soft);
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.15rem 0 0.35rem;
    padding: 0;
    list-style: none;
  }
  .project-tags li {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--ot-bg-soft);
    color: var(--ot-ink-soft);
  }
</style>
