---
// Head: mantém o <head> padrão do Starlight e adiciona o ClientRouter,
// que dá a sensação SPA (transições suaves, sem flash entre páginas).
import Default from "@astrojs/starlight/components/Head.astro";
import { ClientRouter } from "astro:transitions";
---

<Default {...Astro.props}><slot /></Default>
<ClientRouter />
