---
// Header: esquerda só "ori-team", direita nav + tema.
import ThemeToggle from "./ThemeToggle.astro";
import { siteUrl } from "../lib/url";

const homeUrl = siteUrl("/");
const links = [
  { href: homeUrl, label: "home" },
  { href: siteUrl("/projetos/"), label: "projetos" },
  { href: siteUrl("/contribuidores/"), label: "contribuidores" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === homeUrl ? currentPath === homeUrl : currentPath.startsWith(href);
---

<div class="oriteam-header">
  <a href={homeUrl} class="oriteam-brand">ori-team</a>
  <nav class="oriteam-nav" aria-label="Principal">
    {
      links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <ThemeToggle />
</div>
