---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProjectHeader from "../../components/ProjectHeader.astro";
import ProjectToc from "../../components/ProjectToc.astro";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx$/, "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const slug = entry.id.replace(/\.mdx$/, "");
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description ?? `Detalhes do projeto ${entry.data.title}.`}>
  <div class="ot-prose">
    <Breadcrumb trail={[{ href: "/projetos/", label: "projetos" }, { label: entry.data.title }]} />
    <ProjectHeader slug={slug} />
    <article class="ot-markdown">
      <ProjectToc />
      <Content />
    </article>
  </div>
</BaseLayout>
